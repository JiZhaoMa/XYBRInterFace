<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.u9c.mapper.ItemLotCodeMapper">
    <resultMap type="ItemLotCodeInfo" id="ItemLotCodeInfoResult">
        <result property="itemCode"    column="itemCode"/>
        <result property="lotCode"    column="lotCode"/>
        <result property="preLevel"    column="preLevel"/>
    </resultMap>
    <select id="getItemLotCodeList" resultMap="ItemLotCodeInfoResult">
        SELECT
            b.`ITEM_批号` AS lotCode,
            b.`ITEM_优选等级` AS preLevel,
            #{itemCode} AS itemCode
        FROM rdm.`tlk_研发器件库` a, rdm.`tlk_研发器件库厂家型号表` b
        WHERE a.ID = b.PARENT
          AND a.`ITEM_器件编码` = #{itemCode}
    </select>
</mapper>